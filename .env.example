# ClosePilot — Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is in .gitignore.
# On Vercel, set these as Environment Variables in the project dashboard.

# ── Gemini / Google AI ─────────────────────────────────────────────────────────
# Server-side only. Used by api/investigate.ts (serverless function).
# Never prefix with VITE_ — that would bundle the key into the browser.
GEMINI_API_KEY=

# Gemini model name (optional — defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to enable live Gemini LLM; leave unset or "false" for mock mode.
CLOSEPILOT_USE_LIVE_LLM=true

# ── Neatlogs Observability ─────────────────────────────────────────────────────
# Server-side only. Used by api/trace.ts (serverless function).
# Traces fall back gracefully to local JSON if this is not set.
NEATLOGS_API_KEY=
